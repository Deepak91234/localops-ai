# Optional local configuration. Copy to .env; no credentials are needed by the verified Ollama service.
# Existing shell environment values take precedence. Plain values or quoted strings are supported.
LLM_BASE_URL=http://127.0.0.1:11434/v1
MODEL_NAME=nemotron3:33b
LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=900
LOCALOPS_DB_PATH=work/localops.sqlite3
# Optional bookkeeping estimate: measured job processing hours times this USD/hour rate.
# It is not an actual bill, payment, electricity measurement, or physical GPU allocation.
# LOCALOPS_HOURLY_RATE_USD=1.00
# Only needed if your separately configured loopback endpoint requires local authentication.
# LLM_API_KEY=
